    {
      "name": "Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response has a booking ID\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property('bookingid');\n    pm.expect(jsonData.bookingid).to.be.a('number');\n});\n\npm.test(\"Booking details match payload\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.booking.firstname).to.eql(\"Jason\");\n    pm.expect(jsonData.booking.lastname).to.eql(\"Billones\");\n    pm.expect(jsonData.booking.totalprice).to.eql(350);\n    pm.expect(jsonData.booking.depositpaid).to.be.false;\n    pm.expect(jsonData.booking.bookingdates.checkin).to.eql(\"2026-02-10\");\n    pm.expect(jsonData.booking.bookingdates.checkout).to.eql(\"2026-02-14\");\n    pm.expect(jsonData.booking.additionalneeds).to.eql(\"Lunch\");\n});\n\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingId\", jsonData.bookingid);\n\npm.test(\"Content-Type is JSON\", () => {\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});"
            ]
          }
        }
