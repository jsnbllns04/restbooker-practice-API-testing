        {
          "name": "Token generation w/ wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bad credentials do not return a token\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.not.have.property('token');\r\n    pm.expect(jsonData.reason).to.eql(\"Bad credentials\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"wrongpasswrod\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
